# Dependencies
node_modules/

# Build outputs
dist/
dev-dist/
release/
build/

# llama.cpp / TurboQuant — compiled binaries and full source tree.
# The installer pulls from llama-cpp-turboquant/build/bin/Release/ at build time.
# See README "Building from Source" for how to set this up.
redstart-nest/llama-cpp-turboquant/
redstart-nest/llama-server.exe
redstart-nest/deps/

# Android build artifacts
redstart-nest/src/chat-ui/android/.gradle/
redstart-nest/src/chat-ui/android/app/build/
redstart-nest/src/chat-ui/android/build/
redstart-nest/src/chat-ui/android/local.properties

# Logs
*.log
npm-debug.log*

# Environment / secrets
.env
.env.*
*.pem
*.key

# Runtime user data. These normally live in the Electron userData directory
# (%APPDATA%\redstart\) and never appear in the repo — this is belt-and-braces
# for the case where someone copies one in to debug, or points userData at a
# working tree. They contain real conversation history, account records and
# per-profile config, none of which belongs in a public repository.
conversations.json
accounts.json
profiles.json
tools.json
redstart.log
mcp-fs-logs/

# IDE
.idea/
.vscode/

# Claude Code internal files
.claude/

# Compiled APK outputs
redstart-twig/*.apk

# OS
.DS_Store
Thumbs.db
desktop.ini

# Working planning / design documents.
# README.md and CHANGELOG.md are the only architecture docs that ship; plans,
# strategies and status notes are scratch and go stale the moment they land.
/*Plan*.md
/*Strategy*.md
/*PLAN*.md
/ACTION-ITEMS.md
/Redstart *.md
# The patterns above are case-sensitive and assume spaces, so they missed the
# lowercase hyphenated working notes (redstart-observations.md,
# redstart-settings-audit.md, redstart-system-prompt-spec.md, …). Only
# README.md and CHANGELOG.md are tracked at the root, so this is safe.
# Contracts that ship live in docs/ and are deliberately NOT covered here.
/redstart-*.md

# Working notes, wherever they sit. The rule is functional-vs-planning, not
# location: anything the running system or its contracts depend on is tracked
# in docs/ (system-prompt-spec.md, connector-contract.md, tool-namespacing.md);
# plans, audits, backlogs and status notes are scratch and stay local.
#
# This directory exists so working notes have somewhere to live that is NOT the
# repo root. Ignoring it wholesale means a new note never has to be classified
# by filename pattern — which is how redstart-system-prompt-spec.md, a document
# 95 code comments cite as authority, ended up matching /redstart-*.md and
# absent from every clone.
docs/notes/
