{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.redstart.nest",
  "productName": "Redstart Nest",
  "directories": {
    "output": "release/${version}"
  },
  "files": ["electron/main", "dist"],
  "asarUnpack": ["**/*.node", "node_modules/@modelcontextprotocol/server-filesystem/**", "node_modules/sql.js/dist/**"],
  "extraResources": [
    {
      "from": "src/chat-ui/dist",
      "to": "chat-ui",
      "filter": ["**/*"]
    },
    {
      "from": "../shared",
      "to": "shared",
      "filter": ["**/*.mjs"]
    },
    {
      "from": "../THIRD-PARTY-NOTICES.md",
      "to": "THIRD-PARTY-NOTICES.md"
    },
    {
      "from": "LICENSE.txt",
      "to": "LICENSE.txt"
    },
    {
      "from": "licenses",
      "to": "licenses",
      "filter": ["**/*"]
    }
  ],
  "afterPack": "scripts/mac-adhoc-sign.cjs",
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "llama-cpp-turboquant/build/bin/Release",
        "to": "bin",
        "filter": ["llama-server.exe", "*.dll", "*.DLL"]
      },
      {
        "from": "deps/windows",
        "to": "bin",
        "filter": ["*.dll", "*.DLL"]
      },
      {
        "from": "deps/windows/elevate.exe",
        "to": "elevate.exe"
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.developer-tools",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "identity": null,
    "extraResources": [
      {
        "from": "llama-cpp-turboquant/build/bin",
        "to": "bin",
        "filter": ["llama-server", "*.dylib"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Redstart Nest",
    "license": "LICENSE.txt",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "runAfterFinish": true
  }
}
