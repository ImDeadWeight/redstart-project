{
  "server": {
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.example/simple-echo",
    "description": "A trivial stdio MCP server with no required configuration.",
    "version": "1.2.0",
    "packages": [
      {
        "registryType": "npm",
        "registryBaseUrl": "https://registry.npmjs.org",
        "identifier": "@example/simple-echo-mcp",
        "version": "1.2.0",
        "transport": { "type": "stdio" },
        "environmentVariables": [
          { "name": "LOG_LEVEL", "description": "Optional log verbosity.", "default": "info" }
        ]
      }
    ]
  },
  "_meta": {
    "io.modelcontextprotocol.registry/official": {
      "status": "active",
      "isLatest": true
    }
  }
}
