    { "id": "t-read-js", "kind": "search", "query": "read or analyze JavaScript or TypeScript files", "expected": ["read_document", "run_python"], "source": "transcript", "notes": "Qwen3-4B, p4-run-tests: the files were in the workspace." },
    { "id": "t-read-mjs", "kind": "search", "query": "read a JavaScript or MJS file", "expected": ["read_document", "run_python"], "source": "transcript", "notes": "Qwen3-4B, p4-fix-test." },
    { "id": "t-discount-policy", "kind": "search", "query": "standard customer discount policy", "expected": ["search_documents", "memory_search"], "source": "transcript", "notes": "Ornith 1.5, p1-standard-discount: looking for a fact, which only a search could hold." },
    { "id": "t-write-markdown", "kind": "search", "query": "write a markdown file", "expected": ["create_document", "run_python"], "source": "transcript", "notes": "Ornith 1.5, p1-sign-off-name: the note goes in the workspace." },
    { "id": "t-write-local", "kind": "search", "query": "write a file in vault or local file system", "expected": ["create_document", "run_python"], "source": "transcript", "notes": "Qwen3.6-35B, p1-sign-off-name. write_file matches the words and is the wrong store." },
    { "id": "t-write-documents", "kind": "search", "query": "write a file to documents folder", "expected": ["create_document"], "source": "transcript", "notes": "Qwen3.6-35B, p1-skip-no-invent." },
    { "id": "t-save-disk", "kind": "search", "query": "write or save a markdown file to disk", "expected": ["create_document", "run_python"], "source": "transcript", "notes": "Qwen3.6-35B, p1-skip-no-invent." },
    { "id": "t-sort-json", "kind": "search", "query": "sort people in json file and save as csv", "expected": ["run_python"], "source": "transcript", "notes": "Qwen3-4B, p1-answer-steers." },
    { "id": "t-spreadsheet", "kind": "search", "query": "read a spreadsheet", "expected": ["run_python", "read_document"], "source": "transcript", "notes": "Qwen3-4B, multi-recover." },

