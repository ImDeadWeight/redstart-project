    { "id": "t-node-script", "kind": "search", "query": "run node mjs script execute javascript file", "expected": ["run_python"], "source": "transcript", "notes": "Qwen3.6-35B, p4-exit-code, 2026-11-11. run_python until run_command exists." },
    { "id": "t-node-test", "kind": "search", "query": "run node test in a javascript project", "expected": ["run_python"], "source": "transcript", "notes": "Qwen3-4B, p4-run-tests, 2026-11-11." },
    { "id": "t-shell", "kind": "search", "query": "run node command or execute shell commands", "expected": ["run_python"], "source": "transcript", "notes": "Qwen3.6-35B, p4-run-tests." },
    { "id": "t-clone-bundle", "kind": "search", "query": "clone a git bundle or create a repository from a bundle file", "expected": ["run_python"], "source": "transcript", "notes": "Qwen3.6-35B, p4-git-log. No git tool clones; run_python can." },
    { "id": "t-clone-short", "kind": "search", "query": "clone git bundle", "expected": ["run_python"], "source": "transcript", "notes": "Qwen3.6-35B, p4-git-log." },
