    { "id": "u-sqlite", "kind": "selection", "conversation": "How many rows are in the orders table of my sales.db?", "expected": ["sqlite_query", "sqlite_list_tables", "sqlite_describe_table", "sqlite_list_databases"], "source": "user-phrasing" },
    { "id": "u-postgres", "kind": "selection", "conversation": "Query the production Postgres database for last week's signups.", "expected": ["postgres_query"], "source": "user-phrasing" },
    { "id": "u-vault", "kind": "selection", "conversation": "Find my Obsidian notes tagged recipes.", "expected": ["vault_search", "vault_tags"], "source": "user-phrasing" },
    { "id": "u-fs-list", "kind": "selection", "conversation": "What's in my File System folder?", "expected": ["list_directory", "directory_tree", "list_directory_with_sizes"], "source": "user-phrasing" },
    { "id": "u-fs-write", "kind": "selection", "conversation": "Save a file called todo.txt in my File System folder with three items on it.", "expected": ["write_file"], "source": "user-phrasing" },
    { "id": "u-fs-delete", "kind": "selection", "conversation": "Delete old-draft.txt from my File System folder.", "expected": ["delete_file"], "source": "user-phrasing" },
    { "id": "u-fs-move", "kind": "selection", "conversation": "Rename report.txt to report-final.txt in my File System folder.", "expected": ["move_file"], "source": "user-phrasing" },
