      { "role": "user", "content": "Can you check the git log for the trip-planner repo?" },
      { "role": "assistant", "content": "The last commit was 'add budget page' by Sam." },
      { "role": "user", "content": "Great. Now work out the total of the budget numbers 120, 340.5 and 89.99 exactly." }
    ], "expected": ["git_log", "run_python"], "need": "all", "source": "user-phrasing", "notes": "The query is the whole conversation: both turns' tools belong in it." },

