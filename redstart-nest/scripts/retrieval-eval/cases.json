{
  "note": "Labelled cases for the tool retrieval eval (second pass, 0.4). Sources: user-phrasing (asks written the way a user writes them, replacing the first pass's 18 bge asks, which were never committed), attachment (a message with chat-ui's attachment note), transcript (search_tools queries models really wrote in agent-bench runs, 2026-11-11/12), small-model (short queries in the style a small model writes). The bench tasks are added at load time (lib.mjs benchCases). expected: the right tools; need any (default) or all.",
  "cases": [
    { "id": "u-git-changes", "kind": "selection", "conversation": "What changed in my repo since yesterday?", "expected": ["git_log", "git_diff"], "source": "user-phrasing" },
    { "id": "u-git-status", "kind": "selection", "conversation": "Do I have any uncommitted changes in the project?", "expected": ["git_status"], "source": "user-phrasing" },
    { "id": "u-web-news", "kind": "selection", "conversation": "What's the latest news about the Artemis launch?", "expected": ["web_search"], "source": "user-phrasing" },
    { "id": "u-web-page", "kind": "selection", "conversation": "Summarise this article for me: https://example.com/blog/why-we-moved-to-postgres", "expected": ["web_fetch"], "source": "user-phrasing" },
    { "id": "u-papers", "kind": "selection", "conversation": "Find me some recent papers on retrieval-augmented generation.", "expected": ["scholar_search"], "source": "user-phrasing" },
    { "id": "u-python-calc", "kind": "selection", "conversation": "What's the compound interest on $5,000 at 4% a year over 12 years?", "expected": ["run_python"], "source": "user-phrasing" },
    { "id": "u-doc-write", "kind": "selection", "conversation": "Draft a cover letter for the analyst job and save it as a document.", "expected": ["create_document"], "source": "user-phrasing" },
    { "id": "u-doc-list", "kind": "selection", "conversation": "Which documents have I got saved?", "expected": ["list_documents"], "source": "user-phrasing" },
    { "id": "u-doc-search", "kind": "selection", "conversation": "Which of my documents mentions the Henderson contract?", "expected": ["search_documents"], "source": "user-phrasing" },
    { "id": "u-doc-read", "kind": "selection", "conversation": "Open my document meeting-notes.md and tell me the action items.", "expected": ["read_document"], "source": "user-phrasing" },
    { "id": "u-memory-save", "kind": "selection", "conversation": "Remember that my daughter's name is Ines.", "expected": ["memory_save"], "source": "user-phrasing" },
    { "id": "u-memory-recall", "kind": "selection", "conversation": "What do you know about my preferences?", "expected": ["memory_search"], "source": "user-phrasing" },
    { "id": "u-memory-forget", "kind": "selection", "conversation": "Forget what I told you about my home address.", "expected": ["memory_forget"], "source": "user-phrasing" },
