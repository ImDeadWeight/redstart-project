{
	"name": "llama-ui",
	"private": true,
	"version": "1.0.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"build": "npm run build-pwa-assets && vite build",
		"build-pwa-assets": "npx @vite-pwa/assets-generator --root . --config pwa-assets.config.ts && npx @vite-pwa/assets-generator --root . --config pwa-assets-dark.config.ts && node scripts/make-icons-circular.js",
		"dev": "bash scripts/dev.sh",
		"dev:redstart": "vite dev --port 5174 --strictPort",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:baseline": "node scripts/check-svelte-baseline.mjs",
		"reset": "rm -rf .svelte-kit node_modules",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "npm run test:ui -- --run && npm run test:client -- --run && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:pwa": "playwright test tests/e2e/pwa.e2e.ts",
		"test:client": "vitest --project=client",
		"test:unit": "vitest --project=unit",
		"test:unit:pwa": "vitest --project=unit --run tests/unit/pwa.spec.ts",
		"test:security": "vitest --project=unit --run tests/unit/security.test.ts",
		"test:pwa": "npm run test:unit:pwa && npm run test:e2e:pwa",
		"test:ui": "vitest --project=ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"cleanup": "rm -rf .svelte-kit build node_modules test-results dist dev-dist debug-storybook.log static/pwa-*.png static/maskable-icon-*.png static/apple-touch-icon-*.png static/apple-splash-*.png static/favicon*.ico"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.6.0",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "0.515.0",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@playwright/test": "1.65.0",
		"@storybook/addon-a11y": "10.6.7",
		"@storybook/addon-docs": "10.6.7",
		"@storybook/addon-svelte-csf": "5.1.6",
		"@storybook/addon-vitest": "10.6.7",
		"@storybook/sveltekit": "10.6.7",
		"@sveltejs/adapter-static": "3.0.11",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.5",
		"@types/mdast": "4.0.4",
		"@types/node": "26.6.6",
		"@unplugin-pwa/core": "0.0.5",
		"@vite-pwa/assets-generator": "2.0.0",
		"@vite-pwa/sveltekit": "2.0.2",
		"@vitest/browser": "5.1.0",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "5.1.0",
		"bits-ui": "2.20.6",
		"clsx": "2.1.1",
		"dexie": "4.4.7",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-storybook": "10.6.7",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"highlight.js": "11.12.0",
		"http-server": "14.1.1",
		"mdsvex": "0.12.8",
		"mermaid": "11.17.2",
		"pdfjs-dist": "6.5.438",
		"playwright": "1.65.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"rehype-highlight": "7.0.2",
		"rehype-katex": "7.0.1",
		"rehype-stringify": "10.0.1",
		"remark": "15.0.1",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-html": "16.0.1",
		"remark-math": "6.0.0",
		"remark-rehype": "11.1.2",
		"sass": "1.108.1",
		"storybook": "10.6.7",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"svelte-sonner": "1.2.3",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"unified": "11.0.5",
		"unist-util-visit": "5.2.0",
		"uuid": "13.0.2",
		"vite": "8.3.7",
		"vite-plugin-devtools-json": "1.1.2",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "3.1.0",
		"workbox-window": "7.4.1"
	},
	"overrides": {
		"cookie": "1.1.1",
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.6"
		}
	},
	"dependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/app": "^8.1.2",
		"@capacitor/cli": "^8.6.0",
		"@capacitor/core": "^8.6.0"
	}
}
