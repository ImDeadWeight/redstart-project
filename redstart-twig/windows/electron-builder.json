{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.redstart.twig",
  "productName": "Redstart Twig",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "electron/**/*"
  ],
  "asarUnpack": [
    "electron/preload.mjs"
  ],
  "extraFiles": [
    {
      "from": "../../shared",
      "to": "shared",
      "filter": [
        "**/*.mjs"
      ]
    }
  ],
  "extraResources": [
    {
      "from": "../../redstart-nest/src/chat-ui/dist",
      "to": "chat-ui",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../redstart-nest/build/icon.ico",
      "to": "icon.ico"
    }
  ],
  "afterPack": "../../redstart-nest/scripts/mac-adhoc-sign.cjs",
  "win": {
    "target": "nsis",
    "icon": "../../redstart-nest/build/icon.ico"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "icon": "../../redstart-nest/build/icon.png",
    "category": "public.app-category.productivity",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "identity": null
  },
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Redstart Twig",
    "license": "LICENSE.txt",
    "installerIcon": "../../redstart-nest/build/icon.ico",
    "uninstallerIcon": "../../redstart-nest/build/icon.ico",
    "runAfterFinish": true
  }
}
